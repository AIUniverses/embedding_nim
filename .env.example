# Enhanced Embedding Service Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment mode: "simple" or "full"
DEPLOYMENT_MODE=full

# Service configuration
HOST=0.0.0.0
PORT=8009
WORKERS=2
LOG_LEVEL=info
CONFIG_PATH=config/models.yaml

# GPU configuration
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# FEATURE TOGGLES
# =============================================================================

# Enable Redis caching
ENABLE_REDIS=true

# Enable Prometheus/Grafana monitoring
ENABLE_MONITORING=true

# Enable vector database (Qdrant)
ENABLE_VECTOR_DB=true

# Enable advanced caching
ENABLE_CACHING=true

# Enable dynamic batching
ENABLE_BATCHING=true

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Cache backend: "memory", "redis", or "disk"
CACHE_BACKEND=redis

# Cache TTL in seconds
CACHE_TTL=3600

# Maximum cache size (entries for memory, bytes for disk)
CACHE_MAX_SIZE=1000

# Enable cache compression
CACHE_COMPRESSION=false

# =============================================================================
# BATCHING CONFIGURATION
# =============================================================================

# Maximum batch size
MAX_BATCH_SIZE=32

# Batch timeout in milliseconds
BATCH_TIMEOUT_MS=10

# Enable adaptive batch sizing
ADAPTIVE_BATCHING=true

# Number of priority levels
PRIORITY_LEVELS=3

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL (docker-compose builds this from REDIS_PASSWORD)
REDIS_URL=redis://redis:6379

# Redis password - required by docker-compose.yml, generate with `openssl rand -hex 24`
REDIS_PASSWORD=change-me

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus port
PROMETHEUS_PORT=9090

# Grafana port
GRAFANA_PORT=3000

# Grafana admin password - required by docker-compose.yml
GRAFANA_ADMIN_PASSWORD=change-me

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API key for authentication. Required: the service refuses to start without it
# unless ALLOW_UNAUTHENTICATED=true. Generate with `openssl rand -hex 32`.
EMBEDDING_API_KEY=change-me-min-16-chars

# Run without any authentication (local development only)
ALLOW_UNAUTHENTICATED=false

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100

# Allowed CORS origins (comma-separated). Empty disables cross-origin requests.
# '*' is accepted but then credentialed requests are rejected.
CORS_ORIGINS=

# Allowed Host headers (comma-separated, '*' disables Host validation)
ALLOWED_HOSTS=*

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# PyTorch CUDA memory allocation
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Enable model compilation (PyTorch 2.0+)
TORCH_COMPILE=false

# Number of CPU threads for inference
OMP_NUM_THREADS=4

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Enable file logging
LOG_TO_FILE=true

# Log file path
LOG_FILE_PATH=logs/embedding_service.log

# Maximum log file size (MB)
LOG_MAX_SIZE=100

# Number of log files to keep
LOG_BACKUP_COUNT=5

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Default model to load on startup
DEFAULT_MODEL=e5-large-v2

# Model cache directory
MODEL_CACHE_DIR=models

# Auto-download models
AUTO_DOWNLOAD_MODELS=true

# Model loading timeout (seconds)
MODEL_LOAD_TIMEOUT=300

# =============================================================================
# VECTOR DATABASE CONFIGURATION (Qdrant)
# =============================================================================

# Qdrant HTTP port
QDRANT_HTTP_PORT=6333

# Qdrant gRPC port
QDRANT_GRPC_PORT=6334

# Qdrant data directory
QDRANT_DATA_DIR=qdrant_data

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable auto-reload for development
RELOAD=false

# Enable debug mode
DEBUG=false

# Serve /docs, /redoc and /openapi.json (disabled by default)
ENABLE_DOCS=false

# Disable GPU for CPU-only testing
# CUDA_VISIBLE_DEVICES=""

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Container timezone
TZ=UTC

# Container user ID (for file permissions)
PUID=1002

# Container group ID (for file permissions)
PGID=1002
